{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "lerna run build",
		"watch": "lerna run watch --parallel",
		"clean": "lerna run clean",
		"test": "vitest run",
		"lint": "run-s lint:oxlint lint:textlint:fix lint:oxfmt lint:textlint:check",
		"lint:check": "run-s lint:oxlint:check lint:oxfmt:check lint:textlint:check",
		"lint:oxlint": "oxlint --type-aware --fix .",
		"lint:oxlint:check": "oxlint --type-aware --deny-warnings .",
		"lint:oxfmt": "oxfmt --write \"{*,**/*}.{md,mdc,json,js,cjs,mjs,jsx,ts,cts,mts,tsx,css,html,yml,yaml}\"",
		"lint:oxfmt:check": "oxfmt --check \"{*,**/*}.{md,mdc,json,js,cjs,mjs,jsx,ts,cts,mts,tsx,css,html,yml,yaml}\"",
		"lint:textlint:fix": "npx textlint --fix \"{*,**/*}.{md,mdc}\"",
		"lint:textlint:check": "npx textlint \"{*,**/*}.{md,mdc}\"",
		"release": "lerna version --exact --conventional-commits --conventional-graduate --no-push && yarn release:trigger",
		"release:alpha": "lerna version --exact --force-publish --conventional-commits --conventional-prerelease --preid alpha --no-push && yarn release:trigger",
		"release:beta": "lerna version --exact --force-publish --conventional-commits --conventional-prerelease --preid beta --no-push && yarn release:trigger",
		"release:rc": "lerna version --exact --force-publish --conventional-commits --conventional-prerelease --preid rc --no-push && yarn release:trigger",
		"release:trigger": "git push origin main --follow-tags && git tag -f v-release && git push origin v-release -f",
		"prerelease": "yarn build; yarn test",
		"postinstall": "husky",
		"commit": "npx cz",
		"co": "npx cz",
		"update": "yarn upgrade-interactive"
	},
	"workspaces": [
		"packages/@d-zero/*"
	],
	"resolutions": {
		"google-auth-library": "10.9.0",
		"nx/undici": "7.30.1"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-customizable"
		},
		"cz-customizable": {
			"config": "./node_modules/@d-zero/cz-config"
		}
	},
	"devDependencies": {
		"@d-zero/commitlint-config": "6.0.0-alpha.3",
		"@d-zero/lint-staged-config": "6.0.0-alpha.3",
		"@d-zero/oxlint-config": "6.0.0-alpha.3",
		"@d-zero/textlint-config": "6.0.0-alpha.3",
		"@d-zero/tsconfig": "2.0.0",
		"husky": "9.1.7",
		"lerna": "10.1.1",
		"npm-run-all2": "9.0.3",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "6.0.3",
		"vitest": "4.1.12"
	},
	"packageManager": "yarn@4.17.0",
	"volta": {
		"node": "26.7.0",
		"yarn": "4.17.0"
	}
}
